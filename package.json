{
  "name": "portfolio-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json && cp -r data dist/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:ai": "tsx src/services/ai/test.ts",
    "test": "find src -name '*.test.ts' | xargs env ANTHROPIC_API_KEY=test-key ANTHROPIC_MODEL=test-model node --import=tsx --test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.39.0",
    "ajv": "^8.20.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.9.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0"
  }
}