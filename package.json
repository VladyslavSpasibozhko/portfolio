{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:shared": "npm run dev -w @portfolio/shared",
    "dev:server": "npm run dev -w @portfolio/server",
    "dev:client": "npm run dev -w @portfolio/client",
    "build": "npm run build -w @portfolio/shared && npm run build -w @portfolio/server && npm run build -w @portfolio/client",
    "build:server": "npm run build -w @portfolio/shared && npm run build -w @portfolio/server",
    "build:client": "npm run build -w @portfolio/shared && npm run build -w @portfolio/client",
    "start": "npm start -w @portfolio/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.9.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0"
  }
}